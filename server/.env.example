# Copy to .env and edit (server/relay.sh does the copy the first time). Any OpenAI-compatible vision model works:
# a cloud API or one you host yourself. ACTOR_* / PLANNER_* override LLM_* for one role (e.g. a fast actor and a
# stronger planner).

# --- Cloud API (OpenAI-compatible) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini          # any vision-capable chat model
LLM_API_KEY=
LLM_EXTRA_BODY='{}'
# Newer OpenAI models want max_completion_tokens instead of max_tokens; "auto" (default) detects it.
# LLM_TOKEN_PARAM=auto            # auto | max_tokens | max_completion_tokens

# --- Other OpenAI-compatible clouds (examples; pick a vision model from the provider's model list) ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # Alibaba Cloud Model Studio (Qwen-VL)
# LLM_BASE_URL=https://openrouter.ai/api/v1                         # OpenRouter

# --- Local model (optional): vLLM, SGLang, llama.cpp server, Ollama, ... ---
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen3.8-Flash-Next
# LLM_API_KEY=
# Qwen3.8 is tested; turn its thinking mode off for fast, short replies:
# LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# --- Per-role overrides (optional) ---
# ACTOR_MODEL=...      picks one action per screenshot: fast matters most
# PLANNER_MODEL=...    writes and repairs the plan

# --- Board link ---
# LINK=ble                     ble (default): current firmware, this Mac is the app over Bluetooth
#                              sim: simulated board and phone (no hardware); tcp: legacy v0.1.0 firmware + UxPlay
# BLE_NAME=ESP32 Agent 1A2B    only this board (name or prefix), when several are around
# FRAME_MODE=stream            stream (default): live video; snap: fetch the board's buffer after each action (slow)
# SCREEN=board                 where the screen comes from: board (default; over BLE, only ~100 kbps to a Mac,
#                              so it lags behind a moving screen) or uxplay (the phone mirrors to UxPlay on this
#                              Mac over Wi-Fi: real time; needs UxPlay and GStreamer; the board only clicks)
# AIRPLAY_PORT=7200            SCREEN=uxplay: UxPlay's ports (7200-7202); macOS's own AirPlay Receiver holds 7000
# SIM_KBPS=200                 sim: BLE video rate to simulate

# --- UxPlay (SCREEN=uxplay, or legacy LINK=tcp) ---
AIRPLAY_NAME='iPhone Agent'   # receiver name shown in the phone's Screen Mirroring list

# --- Legacy (LINK=tcp) only ---
DEVICE_PORT=7300              # the ESP32 board connects here

PORT=8890                     # web UI: http://127.0.0.1:8890
# HOST=0.0.0.0                # the page controls the phone: it is on this Mac only unless you open it up
# 1: verbose logs + one trace folder per agent run (prompts, replies, screenshots) in ~/.hidagent/traces
HIDAGENT_DEBUG=0
